# Renomeie este arquivo para .env e preencha com suas credenciais reais
# NUNCA suba o arquivo .env para o GitHub (ele já está no .gitignore)

# Firebase — Acesse: https://console.firebase.google.com
VITE_FIREBASE_API_KEY=sua_api_key
VITE_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu_project_id
VITE_FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
VITE_FIREBASE_APP_ID=seu_app_id

# Groq — Acesse: https://console.groq.com
# ⚠️ Em produção, mova isso para uma Cloud Function e não exponha no frontend
VITE_GROQ_API_KEY=sua_groq_api_key
